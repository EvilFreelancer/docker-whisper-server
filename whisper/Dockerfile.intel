ARG UBUNTU_VERSION=24.04
ARG ONEAPI_VERSION=2025.3.2-0
ARG BASE_ONEAPI_DEVEL_CONTAINER=intel/oneapi-basekit:${ONEAPI_VERSION}-devel-ubuntu${UBUNTU_VERSION}

FROM ${BASE_ONEAPI_DEVEL_CONTAINER} AS builder
WORKDIR /app

# Install dependencies
RUN set -xe \
 && apt update -q \
 && apt install -fyq bash wget ffmpeg git make cmake g++ \
 && apt clean

# Repo with sources
ARG WHISPER_REPO="https://github.com/ggerganov/whisper.cpp.git"

# It may be name of branch, tag or commit hash
ARG WHISPER_VERSION="master"

# Clone whisper.cpp repo
RUN set -xe \
 && git clone "$WHISPER_REPO" whisper.cpp
WORKDIR /app/whisper.cpp
RUN set -xe \
 && git checkout "$WHISPER_VERSION" \
 && rm -rf .git

# Build whisper.cpp with SYCL, statically linked like the CUDA image.
# GGML_NATIVE=OFF with an AVX2 baseline: a native build on a CI runner with AVX-512 dies
# with SIGILL (exit 132) right after printing the SYCL devices on CPUs without AVX-512,
# such as Zen 2 Ryzen and older Xeons.
WORKDIR /app/whisper.cpp
RUN set -xe \
 && cmake -B build -DGGML_SYCL=ON -DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx \
      -DBUILD_SHARED_LIBS=OFF -DGGML_NATIVE=OFF -DGGML_AVX=ON -DGGML_AVX2=ON -DGGML_FMA=ON \
      -DGGML_F16C=ON -DWHISPER_BUILD_TESTS=OFF -DCMAKE_BUILD_TYPE=Release \
 && cmake --build build --config Release -j$(nproc)


# The runtime stage keeps the oneAPI image: the SYCL runtime, oneMKL and the GPU driver
# libraries the binaries load at start.
FROM ${BASE_ONEAPI_DEVEL_CONTAINER} AS runtime
WORKDIR /app

# Install basic dependencies
RUN set -xe \
 && apt update -q \
 && apt install -fyq bash wget ffmpeg \
 && apt clean

# Create folders
RUN set -xe \
 && mkdir -pv /app/models /app/audios

# Copy compiled tools
COPY --from=builder /app/whisper.cpp/models/download-ggml-model.sh .
COPY --from=builder /app/whisper.cpp/build/bin/whisper-bench .
COPY --from=builder /app/whisper.cpp/build/bin/whisper-server .
COPY --from=builder /app/whisper.cpp/build/bin/whisper-cli .
COPY --from=builder /app/whisper.cpp/build/bin/whisper-quantize .

# The reorder optimization of ggml-sycl turns q8_0 models into garbage on Arc A-series
# (DG2) while the speed looks fine; f16 models are correct either way. Set it to 1 only
# after checking the transcript of a known recording.
ENV GGML_SYCL_ENABLE_OPT=0 \
    ZES_ENABLE_SYSMAN=1

# Init entrypoint
ADD entrypoint.sh .
RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
